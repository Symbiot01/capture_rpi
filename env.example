# Copy to ~/capture/.env or /etc/hid-capture.env (never commit real values).

# Slice C — WHIP publish target (MediaMTX path "cam", not "desk")
WHIP_URL=https://mediarelay.sahilpatel.online/cam/whip

# Optional ICE (usually MediaMTX advertises; STUN helps NAT)
# WHIP_STUN=stun:stun.l.google.com:19302

# Slice D — local still HTTP
STILL_HOST=127.0.0.1
STILL_PORT=8091
# Generate: openssl rand -hex 24
CAPTURE_TOKEN=

# Encode defaults (Slices B/C)
WIDTH=1280
HEIGHT=720
FPS=30

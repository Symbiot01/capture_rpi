[Unit]
Description=HID capture outbound WebSocket agent (Slice E photo)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/capture
EnvironmentFile=-/etc/hid-capture.env
EnvironmentFile=-/home/dev/capture/.env
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/python3 /home/dev/capture/scripts/capture_ws.py
Restart=always
RestartSec=3
# Do NOT set NoNewPrivileges=yes — blocks sudo -n systemctl for whip.service
[Install]
WantedBy=multi-user.target

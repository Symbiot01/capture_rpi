[Unit]
Description=HID capture outbound WebSocket agent (Slice E photo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dev
WorkingDirectory=/home/dev/capture
EnvironmentFile=-/etc/hid-capture.env
EnvironmentFile=-/home/dev/capture/.env
ExecStart=/usr/bin/python3 /home/dev/capture/scripts/capture_ws.py
Restart=always
RestartSec=3
# Do not put secrets on the command line.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=HID capture WHIP publisher (MediaMTX cam path)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/capture
EnvironmentFile=-/etc/hid-capture.env
EnvironmentFile=-/home/pi/capture/.env
# Slice C: replace with real publish_whip once implemented
ExecStart=/home/pi/capture/scripts/publish_whip.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
